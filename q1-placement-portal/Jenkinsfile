// Q1 - Automated Student Placement Portal
// Works on Linux/macOS agents (sh) and Windows agents (bat).
// Credentials needed in Jenkins:
//   dockerhub-creds : Username with password
//   kubeconfig      : Secret file (your ~/.kube/config)

def run(String cmd) {
    if (isUnix()) { sh cmd } else { bat cmd }
}
def v(String name) {
    return isUnix() ? "\$${name}" : "%${name}%"
}

pipeline {
    agent any

    parameters {
        booleanParam(name: 'FAULTY_BUILD', defaultValue: false,
                     description: 'Tick to build a deliberately broken image (demo auto-rollback)')
    }

    environment {
        DOCKERHUB_USER = 'suhaib08'
        APP            = 'placement-portal'
        IMAGE          = "${DOCKERHUB_USER}/placement-portal"
        TAG            = "${BUILD_NUMBER}"
    }

    stages {
        stage('Clone Code') {
            steps {
                git branch: 'main', url: 'https://github.com/suhaib08/placement-portal.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    run("docker build --build-arg FAULTY=${params.FAULTY_BUILD} -t ${IMAGE}:${TAG} -t ${IMAGE}:latest q1-placement-portal")
                }
            }
        }

        stage('Test Application') {
            steps {
                run("docker image inspect ${IMAGE}:${TAG}")
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                  usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                    script {
                        run("echo ${v('DH_PASS')}| docker login -u ${v('DH_USER')} --password-stdin")
                        run("docker push ${IMAGE}:${TAG}")
                        run("docker push ${IMAGE}:latest")
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    script {
                        // Create the Deployment and Service the first time.
                        run("kubectl get deployment ${APP} || kubectl apply -f q1-placement-portal/deployment.yaml")
                        run("kubectl set image deployment/${APP} ${APP}=${IMAGE}:${TAG}")

                        try {
                            run("kubectl rollout status deployment/${APP} --timeout=90s")
                        } catch (err) {
                            echo "Rollout FAILED - rolling back to previous stable release"
                            run("kubectl rollout undo deployment/${APP}")
                            run("kubectl rollout status deployment/${APP} --timeout=120s")
                            env.ROLLED_BACK = 'true'
                            error("Release ${TAG} failed. Rolled back to previous stable version.")
                        }
                    }
                }
            }
        }

        stage('Verify Pods') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    run("kubectl get pods -l app=${APP}")
                    run("kubectl get svc placement-portal-service")
                }
            }
        }
    }

    post {
        success {
            echo "Deployed. Open http://localhost:30081"
        }
        failure {
            withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                script {
                    run("kubectl get pods -l app=${APP}")
                    run("kubectl rollout history deployment/${APP}")
                }
            }
        }
    }
}